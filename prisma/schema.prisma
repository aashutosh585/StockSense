generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Core User entity containing user profile, role, password, and relations
model User {
  id            String    @id @default(cuid())
  loginId       String?   @unique
  name          String?
  email         String?   @unique
  passwordHash  String?   @map("password")
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  // Relationships
  accounts      Account[]
  sessions      Session[]
  stockMoves    StockMove[]
}

/// OAuth Account details linked to user profile
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Active web session tokens for authenticated users
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Sign up / Sign in email verification tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// CORE INVENTORY SYSTEM MODELS
// -----------------------------------------------------------------------------

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  shortCode String     @unique
  address   String?
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id          String      @id @default(cuid())
  name        String
  shortCode   String
  warehouseId String?
  warehouse   Warehouse?  @relation(fields: [warehouseId], references: [id])
  type        String      @default("internal") // internal, vendor, customer, loss
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  movesFrom StockMove[] @relation("LocationFrom")
  movesTo   StockMove[] @relation("LocationTo")

  @@unique([warehouseId, shortCode])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String     @id @default(cuid())
  name        String
  sku         String     @unique
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  unitCost    Float      @default(0)
  onHand      Int        @default(0)
  freeToUse   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  moveLines   StockMoveLine[]
}

model Contact {
  id        String      @id @default(cuid())
  name      String
  email     String?
  type      String      @default("vendor") // vendor, customer
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  moves     StockMove[]
}

model StockMove {
  id              String   @id @default(cuid())
  reference       String   @unique // e.g., WH/IN/0001
  type            String   // receipt, delivery, transfer, adjustment
  status          String   @default("draft") // draft, waiting, ready, done
  scheduleDate    DateTime
  
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id])
  
  fromLocationId  String?
  fromLocation    Location? @relation("LocationFrom", fields: [fromLocationId], references: [id])
  
  toLocationId    String?
  toLocation      Location? @relation("LocationTo", fields: [toLocationId], references: [id])

  responsibleId   String?
  responsible     User?    @relation(fields: [responsibleId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           StockMoveLine[]
}

model StockMoveLine {
  id          String    @id @default(cuid())
  moveId      String
  move        StockMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
