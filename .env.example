# ==========================================================
# STOCKSENSE ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================================

# 1. DATABASE (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. NEXTAUTH & SECURITY
AUTH_SECRET="your-32-character-auth-secret-key-here"
NEXTAUTH_SECRET="your-32-character-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# 3. GOOGLE OAUTH
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
